{
  "name": "aster-digital",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:api\"",
    "build": "npm run build:web && npm run build:api",
    "preview": "vite preview --host 127.0.0.1",
    "dev:web": "vite --host localhost",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "db:local": "node scripts/local-db.mjs",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "node scripts/prisma.mjs migrate deploy",
    "db:seed": "tsx apps/api/prisma/seed.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/api/tsconfig.json",
    "build:web": "tsc --noEmit && vite build",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "start": "node apps/api/dist/index.js",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"apps/api/src/**/*.ts\" \"apps/api/prisma/*.ts\" \"scripts/*.{mjs,ts}\" \"tests/**/*.ts\" \"*.{json,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"apps/api/src/**/*.ts\" \"apps/api/prisma/*.ts\" \"scripts/*.{mjs,ts}\" \"tests/**/*.ts\" \"*.{json,ts}\"",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "node scripts/test-integration.mjs",
    "seo:generate": "tsx scripts/seo.ts",
    "db:backup": "node scripts/backup.mjs backup",
    "db:restore-test": "node scripts/backup.mjs restore-test"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^10.74.0",
    "@sentry/react": "^10.74.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.6.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.5.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.5.0",
    "agent-browser": "^0.37.1",
    "concurrently": "^10.0.5",
    "embedded-postgres": "^18.4.0-beta.17",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
